{
  "name": "functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for scheduled tasks",
  "main": "index.js",
  "scripts": {
    "lint": "echo 'No linting configured'",
    "build": "echo 'No build step required'",
    "serve": "firebase emulators:start --only functions",
