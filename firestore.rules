rules_version = '2';

// PickEm Paintball — Firestore security rules
//
// The Firebase API key is public by design (NEXT_PUBLIC_FIREBASE_API_KEY ships in
// the browser bundle). It identifies the project; it authorises nothing. These
// rules are the ONLY access control — anyone can call firestore.googleapis.com
// directly with that key, bypassing the app entirely.
//
// Cloud Functions (Admin SDK) and the Apps Script uploader (service account) both
// bypass rules completely, so locking a collection to read-only here does not stop
// the stats pipeline from writing to it.
//
// STAGED ROLLOUT — see ROSTER_IDENTITY.md and the session notes.
//   Stage 1 (this file): game data is read-only. Verified 22 Aug 2026 that not a
//           single client or API route writes to any collection below.
//   Stage 2 (pending): convert the ~25 server routes that use the CLIENT SDK over
//           to firebase-admin. Until that lands they are indistinguishable from an
//           anonymous visitor, so `users` / `leagues` / `notifications` /
//           `shareCards` cannot yet require auth without breaking them.
//   Stage 3 (pending): lock those four to authenticated, own-document access and
//           move PII (email, real name, Stripe ids) out of the readable user doc.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Game data — read-only to every client ────────────────────────────────
    // Written only by Cloud Functions and Apps Script, which bypass these rules.

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;

      match /players/{playerId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false;
    }

    // Granular kill rows — the source of truth for every stat.
    match /long_data/{rowId} {
      allow read: if true;
      allow write: if false;
    }

    // Player career projections — one document per player, holding everything the
    // career page renders. Derived entirely from the collections above, so it carries
    // no information a client could not already read; it exists to make one read do
    // the work of ~6,200. Written only by the rebuild and, later, the recompute.
    match /playerSummaries/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    // Small derived indexes — currently just the player list behind the search box.
    // Same rationale as playerSummaries: derived from readable collections, exists so
    // one read does the work of hundreds.
    match /aggregates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Upload manifests. Nothing client-side reads these; they trigger the recompute.
    match /uploads/{uploadId} {
      allow read: if false;
      allow write: if false;
    }

    // Pre-aggregated season tables. season_2025 was retired 22 Aug 2026 (the stats
    // page computes 2025 live); season_2024 remains and is not surfaced in the UI.
    match /players/{seasonId} {
      allow read: if true;
      allow write: if false;

      match /players/{playerId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // CMS content and badge-rarity counters — published by admin tooling.
    match /cmsPages/{pageId} {
      allow read: if true;
      allow write: if false;
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Still open — blocked on the Admin SDK conversion (stage 2) ───────────
    // These receive writes from client code AND from server routes that currently
    // use the client SDK, so they have no auth context to key a rule on yet.
    // TODO(stage 3): require request.auth and restrict to the owning document.

    // users/{uid} — doc id == Firebase Auth uid (login, register and every client
    // write use doc(db, "users", user.uid)). Reads stay public for now (stage 3).
    //
    // Writes:
    //  * create — only the signed-in owner, and never with picks in it (a new doc
    //    starts with `pickems: {}` or none; picks are always saved by update).
    //  * update by the owner — anything, except that a change to the `pickems` map
    //    must be a pick save for ONE event whose picks are still open:
    //      - the same write sets top-level `pickemsEventId` to that event's id
    //        (rules cannot pull a key out of a set, so the client names the event);
    //      - every changed pickems key is <id>, <id>_captain, <id>_draft or
    //        <id>_draft_captain;
    //      - events/<id>.lockDate is a timestamp and the server clock is before it.
    //        No lockDate (or not a timestamp) = locked, same as the pick page.
    //  * update by anyone else — still needed because ~10 server routes write user
    //    docs with the CLIENT SDK and so arrive here anonymous (see stage 2 above).
    //    Limited to exactly the fields those routes write; never pickems or profile.
    //  * delete — nobody; no client deletes a user doc (admin scripts bypass rules).
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function mapOrEmpty(data) {
        return data.get('pickems', {}) is map ? data.get('pickems', {}) : {};
      }

      function picksOpen(eventId) {
        let ev = /databases/$(database)/documents/events/$(eventId);
        return exists(ev)
          && get(ev).data.get('lockDate', null) is timestamp
          && request.time < get(ev).data.lockDate;
      }

      function pickemsWriteOk() {
        let changed = mapOrEmpty(request.resource.data).diff(mapOrEmpty(resource.data)).affectedKeys();
        let e = request.resource.data.get('pickemsEventId', null);
        return changed.size() == 0
          || (e is string
              && e.size() > 0
              && !e.matches('.*/.*')
              && changed.hasOnly([e, e + '_captain', e + '_draft', e + '_draft_captain'])
              && picksOpen(e));
      }

      // Fields written by the client-SDK server routes (leagues/*, stripe/*,
      // share/link). Remove this branch once stage 2 moves them to firebase-admin.
      function serverRouteFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'leagues', 'adminLeagues', 'leagueRequests',
          'isSubscribed', 'subscriptionTier', 'subscriptionStatus',
          'subscriptionCurrentPeriodEnd', 'subscriptionCancelAtPeriodEnd',
          'stripeCustomerId', 'stripeSubscriptionId',
          'lastPaymentDate', 'lastPaymentAmount', 'paymentFailed', 'lastPaymentFailedDate',
          'updatedAt', 'shareId'
        ]);
      }

      allow read: if true;

      allow create: if isOwner()
        && (!('pickems' in request.resource.data)
            || (request.resource.data.pickems is map && request.resource.data.pickems.size() == 0));

      allow update: if (isOwner()
                        && (!('pickems' in request.resource.data) || request.resource.data.pickems is map)
                        && pickemsWriteOk())
                    || serverRouteFieldsOnly();

      allow delete: if false;
    }

    match /leagues/{leagueId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /shareCards/{shareId} {
      allow read, write: if true;
    }

    // Share telemetry — one row per finished share attempt, written by
    // /api/share/track. That route is on the client SDK too, so it is anonymous
    // here and `create` has to stay open (stage 2 closes it). Everything else is
    // shut: nobody can read back who shared what, or edit the record afterwards.
    // scripts/share-report.mjs reads it with the Admin SDK, which bypasses rules.
    match /shareEvents/{recordId} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    // Anything not named above is unreachable from a client. Adding a collection
    // means adding a rule for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
