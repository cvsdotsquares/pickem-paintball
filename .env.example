# Local dev must use the SAME Firebase web config as production, or auth/Firestore will fail
# while the deployed site still works. Copy every NEXT_PUBLIC_FIREBASE_* from Vercel (or your host)
# into `.env.local` and restart `npm run dev`.
#
# Phone on LAN (http://192.168.x.x:3000): Firebase Console → Authentication → Settings →
# Authorized domains → Add domain and enter your machine IP (e.g. 192.168.1.12). `localhost`
# is already allowed for laptop-only testing.
#
# If production works but localhost login fails: Google Cloud Console → APIs & Services →
# Credentials → your Browser API key → Application restrictions → HTTP referrers must include
# http://localhost:*/* and http://127.0.0.1:*/* (and your LAN URL for phone).
#
# Optional — only for local debugging if you need to sign in before clicking the email link:
# NEXT_PUBLIC_DEV_ALLOW_UNVERIFIED_LOGIN=true

# Existing Firebase variables
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cron Job Security
CRON_SECRET=your_random_secret_here
