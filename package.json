{
  "name": "nextjs-pickem-paintball",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:turbo": "next dev -H 0.0.0.0 --turbopack",
    "dev:lan": "next dev -H 0.0.0.0 -p 3001",
    "clean": "rm -rf .next node_modules/.cache",
    "dev:clean": "npm run clean && next dev -H 0.0.0.0",
    "phone-url": "node -e \"const os=require('os');for(const nets of Object.values(os.networkInterfaces())){for(const n of nets||[])if(n.family==='IPv4'&&!n.internal)console.log('Open on phone: http://'+n.address+':3000')}\"",
    "dev:stop": "sh -c 'for p in 3000 3001 3002 3003; do lsof -ti tcp:$p -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null; done; exit 0'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "migrate-players": "node scripts/migrate-players.mjs"
  },
  "dependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@subframe/core": "^1.137.0",
    "@twallpaper/react": "^2.1.2",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "firebase": "^11.3.1",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.15.0",
    "lenis": "^1.3.4",
    "lodash": "^4.17.21",
    "lucide-react": "^1.7.0",
    "mantine-datatable": "^7.15.1",
    "next": "15.5.14",
    "nextjs-toploader": "^3.7.15",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.4.0",
    "react-popper": "^2.3.0",
    "react-resizable-panels": "^2.1.7",
    "react-toastify": "^11.0.5",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.0.2",
    "twallpaper": "^2.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.2.5",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.14",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
